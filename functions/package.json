{
  "name": "stregis-enrollment-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for St Regis Enrollment System",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "@google-cloud/tasks": "^5.8.0",
    "resend": "^4.0.1",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1",
    "firebase-functions-test": "^3.3.0"
  },
  "private": true
}

