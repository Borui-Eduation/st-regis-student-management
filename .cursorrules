## 📊 监控和日志

### 1. 性能监控

```typescript
// 添加性能追踪
export async function GET(req: NextRequest) {
  const startTime = Date.now();
  let firestoreReads = 0;
  let cacheHit = false;
  
  try {
    const data = await tieredCachedFetch(key, async () => {
      firestoreReads = 1;
      return await fetchData();
    });
    cacheHit = true;
    
    return NextResponse.json({ data });
  } finally {
    // 记录性能指标
    console.log({
      api: '/api/admin/stats',
      responseTime: Date.now() - startTime,
      firestoreReads,
      cacheHit,
      timestamp: new Date().toISOString()
    });
  }
}
```

### 2. 错误日志

```typescript
// 统一错误处理
try {
  // API逻辑
} catch (error: any) {
  console.error('API错误:', {
    api: req.url,
    error: error.message,
    stack: error.stack,
    timestamp: new Date().toISOString()
  });
  
  return createErrorResponse(error, 'Operation failed');
}
```

