# ============================================
# St Regis 选课系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env.local 并填入实际值

# Firebase 配置（公开）
NEXT_PUBLIC_FIREBASE_PROJECT_ID=borui-education
NEXT_PUBLIC_FIREBASE_DATABASE_ID=studentapp
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=borui-education.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=borui-education.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin（私密）
FIREBASE_ADMIN_CLIENT_EMAIL=studentapp@borui-education.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n从 json 文件复制\n-----END PRIVATE KEY-----\n"

# Google Cloud Tasks
GOOGLE_CLOUD_PROJECT=borui-education
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_TASKS_QUEUE_NAME=enrollment-processing

# Resend 邮件（必需）
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@stregis.edu

# Moodle 集成（可选）
MOODLE_URL=https://moodle.stregis.edu
MOODLE_TOKEN=
MOODLE_SERVICE=moodle_mobile_app

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
IT_EMAIL=it@stregis.edu
